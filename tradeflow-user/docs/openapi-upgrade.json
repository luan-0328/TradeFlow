            },
            "description": "服务端验证必须等于路径且包含于最新有效成员归属"
          }
        ],
        "responses": {
          "200": {
            "description": "成功，data精确对象见配套契约说明",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MerchantMemberView"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
