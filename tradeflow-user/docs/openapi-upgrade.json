        "description": "仅当前路径及X-Merchant-Id对应商家的有效ADMIN。A店ADMIN不能凭B店OPERATOR身份维护B成员。职级/状态变更、目标Token撤销与审计同事务；最后有效ADMIN返回409 LAST_MERCHANT_ADMIN。",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^merchant_[a-z0-9_]{1,48}$"
            }
          },
          {
            "name": "X-Merchant-Id",
            "in": "header",
            "required": true,
