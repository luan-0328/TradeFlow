          },
          "403": {
            "description": "无权限"
          },
          "404": {
            "description": "资源不存在或不属于当前用户"
          },
          "409": {
            "description": "LAST_MERCHANT_ADMIN：不能降级或停用最后有效管理员；失败整体回滚"
          }
        },
        "x-merchant-roles": [
          "ADMIN"
        ]
      },
      "put": {
        "summary": "PUT /api/v1/merchants/{id}/members",
        "description": "仅当前路径及X-Merchant-Id对应商家的有效ADMIN。A店ADMIN不能凭B店OPERATOR身份维护B成员。职级/状态变更、目标Token撤销与审计同事务；最后有效ADMIN返回409 LAST_MERCHANT_ADMIN。",
