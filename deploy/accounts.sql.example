GRANT ALL PRIVILEGES ON `trade_product`.* TO 'tf_product_migrator'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_product`.`product` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_product`.`sku` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_product`.`product_quote` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT ON `trade_product`.`quote_item` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_product`.`inventory` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_product`.`reservation_header` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT ON `trade_product`.`reservation_item` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_product`.`inventory_receipt` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT ON `trade_product`.`receipt_item` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT ON `trade_product`.`inventory_ledger` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_product`.`idempotency_request` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_product`.`process_task` TO 'tf_product_app'@'%';
GRANT SELECT, INSERT ON `trade_product`.`audit_log` TO 'tf_product_app'@'%';
