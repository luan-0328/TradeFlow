-- 历史最终目标模型账号模板，不匹配B5分阶段实际表；禁止作为当前环境账号脚本执行。
-- 当前本机逐表/列权限以scripts/Prepare-Dev.py为准，迁移账号与运行账号必须分离。
-- 模板：禁止直接执行。将 __SECRET_*__ 由受保护部署流程替换，不提交真实密码。
-- 每库独立运行账号与迁移账号；% 只用于私网容器网络，部署时应限制来源。
CREATE USER 'tf_user_app'@'%' IDENTIFIED BY '__SECRET_USER_APP__';
CREATE USER 'tf_user_migrator'@'%' IDENTIFIED BY '__SECRET_USER_MIGRATOR__';
GRANT ALL PRIVILEGES ON `trade_user`.* TO 'tf_user_migrator'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_user`.`user_account` TO 'tf_user_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_user`.`role` TO 'tf_user_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_user`.`user_role` TO 'tf_user_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_user`.`merchant_member` TO 'tf_user_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_user`.`idempotency_request` TO 'tf_user_app'@'%';
GRANT SELECT, INSERT, UPDATE ON `trade_user`.`process_task` TO 'tf_user_app'@'%';
GRANT SELECT, INSERT ON `trade_user`.`audit_log` TO 'tf_user_app'@'%';
