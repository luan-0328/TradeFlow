# 这是 prod 模式环境变量说明，不会被 Start-Local.ps1 自动加载。
# 用迁移账号执行迁移，应用正常运行改为低权限账号；禁止业务进程使用 root。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
TRADEFLOW_MIGRATIONS_ENABLED=false
TRADEFLOW_USER_DB_USER=tf_user_app
TRADEFLOW_USER_DB_PASSWORD=
TRADEFLOW_PRODUCT_DB_USER=tf_product_app
TRADEFLOW_PRODUCT_DB_PASSWORD=
# 独立迁移进程所需，禁止注入长期运行的业务JVM。
TRADEFLOW_USER_MIGRATION_USER=tf_user_migrate
TRADEFLOW_USER_MIGRATION_PASSWORD=
TRADEFLOW_PRODUCT_MIGRATION_USER=tf_product_migrate
TRADEFLOW_PRODUCT_MIGRATION_PASSWORD=
TRADEFLOW_ORDER_MIGRATION_USER=tf_order_migrate
TRADEFLOW_ORDER_MIGRATION_PASSWORD=
# 用户服务持有私钥；其他服务仅持公钥。文件使用PKCS8/X509 PEM。
TRADEFLOW_JWT_PUBLIC_KEY=
TRADEFLOW_JWT_PRIVATE_KEY=
TRADEFLOW_JWT_ISSUER=tradeflow
# 仅用户服务读取。QQ邮箱开启SMTP后使用授权码，不能填QQ登录密码。
TRADEFLOW_MAIL_USERNAME=
TRADEFLOW_MAIL_PASSWORD=
TRADEFLOW_PRODUCT_SERVICE_TOKEN=
TRADEFLOW_ORDER_SERVICE_TOKEN=
TRADEFLOW_USER_SERVICE_URL=http://127.0.0.1:8081
TRADEFLOW_PRODUCT_SERVICE_URL=http://127.0.0.1:8082
TRADEFLOW_BOOTSTRAP_ENABLED=false
TRADEFLOW_BOOTSTRAP_USERNAME=platform_admin
TRADEFLOW_BOOTSTRAP_PASSWORD=
TRADEFLOW_ORDER_DB_USER=tf_order_app
TRADEFLOW_ORDER_DB_PASSWORD=
TRADEFLOW_PAYMENT_DB_USER=tf_payment_app
TRADEFLOW_PAYMENT_DB_PASSWORD=
TRADEFLOW_AFTERSALE_DB_USER=tf_aftersale_app
TRADEFLOW_AFTERSALE_DB_PASSWORD=
TRADEFLOW_PAYMENT_SIMULATOR_DB_USER=tf_simulator_app
TRADEFLOW_PAYMENT_SIMULATOR_DB_PASSWORD=
NACOS_SERVER_ADDR=127.0.0.1:18848
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=
# 控制台地址以及控制台可达的当前 JVM IP；生产不可直接照抄开发回环拓扑。
SENTINEL_DASHBOARD=
SENTINEL_CLIENT_IP=
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=15673
RABBITMQ_USERNAME=tradeflow
RABBITMQ_PASSWORD=
PAYMENT_SIMULATOR_URL=http://127.0.0.1:8086

# B3 独立凭据，各用途随机生成，禁止相互复用。
TRADEFLOW_PAYMENT_SERVICE_TOKEN=
TRADEFLOW_CHANNEL_SERVICE_TOKEN=
TRADEFLOW_CALLBACK_SECRET=
TRADEFLOW_SIMULATOR_ADMIN_TOKEN=
TRADEFLOW_PAYMENT_MIGRATION_USER=tf_payment_migrate
TRADEFLOW_PAYMENT_MIGRATION_PASSWORD=
TRADEFLOW_PAYMENT_SIMULATOR_MIGRATION_USER=tf_payment_simulator_migrate
TRADEFLOW_PAYMENT_SIMULATOR_MIGRATION_PASSWORD=
TRADEFLOW_PAYMENT_SERVICE_URL=http://127.0.0.1:8084
TRADEFLOW_ORDER_SERVICE_URL=http://127.0.0.1:8083
TRADEFLOW_CHANNEL_SERVICE_URL=http://127.0.0.1:8086

# B4售后调用凭据与独立迁移账户
TRADEFLOW_AFTERSALE_SERVICE_TOKEN=
TRADEFLOW_AFTERSALE_MIGRATION_USER=tf_aftersale_migrate
TRADEFLOW_AFTERSALE_MIGRATION_PASSWORD=

# B5运行账户用途分离，管理员仅基础设施准备持有，禁止注入业务JVM。
TRADEFLOW_MESSAGING_ENABLED=true
RABBITMQ_VHOST=/tradeflow
TRADEFLOW_PAYMENT_MQ_USER=tf_payment_mq
TRADEFLOW_PAYMENT_MQ_PASSWORD=
TRADEFLOW_ORDER_MQ_USER=tf_order_mq
TRADEFLOW_ORDER_MQ_PASSWORD=
TRADEFLOW_AFTERSALE_MQ_USER=tf_aftersale_mq
TRADEFLOW_AFTERSALE_MQ_PASSWORD=
