{
  "uid": "tradeflow",
  "title": "TradeFlow · 本机只读可观测性",
  "description": "初始演示阈值，非生产SLO；UNKNOWN与退款占用为原业务创建时长。NaN/缺失保持空白，不填零。",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "tradeflow"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP请求率",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradeflow-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(application) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{__name__}} {{application}} {{kind}} {{queue}} {{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP错误率",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradeflow-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by(application) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{__name__}} {{application}} {{kind}} {{queue}} {{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP P95（直方图）",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradeflow-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(application,le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{__name__}} {{application}} {{kind}} {{queue}} {{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM堆内存",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradeflow-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{__name__}} {{application}} {{kind}} {{queue}} {{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM GC暂停",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradeflow-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(application) (rate(jvm_gc_pause_seconds_sum[5m]))",
          "legendFormat": "{{__name__}} {{application}} {{kind}} {{queue}} {{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hikari活动/等待连接",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradeflow-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active or hikaricp_connections_pending",
          "legendFormat": "{{__name__}} {{application}} {{kind}} {{queue}} {{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "业务积压（固定kind）",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradeflow-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeflow_business_backlog",
          "legendFormat": "{{__name__}} {{application}} {{kind}} {{queue}} {{pool}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "最老未决创建时长",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
