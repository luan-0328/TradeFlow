      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradeflow-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeflow_business_backlog{kind=~\"payment_unknown|refund_unknown\"}",
